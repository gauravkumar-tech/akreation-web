---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "center" | "left";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = "center",
  class: className = "",
} = Astro.props;

const alignment = align === "center" ? "text-center mx-auto" : "text-left";
---

<div class={`max-w-3xl ${alignment} ${className}`}>
  {eyebrow && (
    <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-5">
      {eyebrow}
    </p>
  )}
  <h2
    class="font-display font-medium text-4xl md:text-5xl leading-[1.08] tracking-[-0.01em] text-ink dark:text-[#ece7dd]"
    set:html={title.endsWith(".") ? title : `${title}.`}
  />
  {description && (
    <p class="mt-5 text-[17px] leading-[1.75] text-body dark:text-[#b8b0a3] font-light max-w-2xl mx-auto">
      {description}
    </p>
  )}
  <div class="gold-divider w-24 mx-auto mt-7" />
</div>
