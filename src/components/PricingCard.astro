---
interface Props {
  name: string;
  tagline: string;
  price: string;
  originalPrice?: string;
  savings?: string;
  paymentType?: string;
  currency?: string;
  featured?: boolean;
  features: string[];
  cta?: string;
  ctaHref?: string;
  class?: string;
}

const base = import.meta.env.BASE_URL;
const {
  name,
  tagline,
  price,
  originalPrice,
  savings,
  paymentType = "One Time Payment",
  currency = "₹",
  featured = false,
  features,
  cta = "Book now",
  ctaHref = `${base}contact`,
  class: className = "",
} = Astro.props;

// Root-absolute data hrefs ("/contact") get the site base; remote URLs stay as-is
const resolvedCta = ctaHref.startsWith("http")
  ? ctaHref
  : `${base}${ctaHref.replace(/^\//, "")}`;

const cardClass = featured
  ? "relative overflow-hidden bg-espresso text-[#ece7dd] rounded-lg p-8 shadow-card-xl ring-1 ring-brass/60 dark:bg-[#0e0c0a]"
  : "bg-canvas text-ink rounded-lg p-8 border border-hairline shadow-card hover:shadow-card-lg hover:-translate-y-1 transition-all duration-500 dark:bg-[#1c1917] dark:text-[#ece7dd] dark:border-[#2e2a26]";

const ctaClass = featured
  ? "btn-shine w-full h-12 flex items-center justify-center rounded-full bg-[#fdfbf7] text-espresso font-medium text-[13px] uppercase tracking-[0.14em] hover:bg-rose-deep hover:text-white hover:shadow-rose transition-all"
  : "btn-shine w-full h-12 flex items-center justify-center rounded-full bg-espresso text-[#fdfbf7] font-medium text-[13px] uppercase tracking-[0.14em] hover:bg-rose-deep hover:shadow-rose transition-all dark:bg-[#ece7dd] dark:text-[#1c1917] dark:hover:bg-rose dark:hover:text-white";
---

<div class={`${cardClass} ${className}`} data-reveal>
  {featured && (
    <>
      <div aria-hidden="true" class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-transparent via-[#f6e27a] to-transparent shadow-[0_0_14px_rgb(246_226_122/0.8)]" />
      <div aria-hidden="true" class="blush-glow absolute inset-0 pointer-events-none" />
    </>
  )}

  <div class="relative">
    <p class={`text-[11px] font-medium uppercase tracking-[0.28em] mb-2 ${featured ? "text-brass" : "text-brass-deep dark:text-brass"}`}>{name}</p>
    <p class={`font-display italic text-[17px] mb-5 ${featured ? "text-[#cfc8ba]" : "text-body dark:text-[#b8b0a3]"}`}>{tagline}</p>

    <div class="mb-7">
      {originalPrice && (
        <span class="text-sm font-light opacity-50 line-through">{currency}{originalPrice}</span>
      )}
      {savings && (
        <span class="ml-2 inline-block px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.14em] rounded-full bg-brass-soft text-brass-deep dark:bg-[#2e2a22] dark:text-brass">
          Save {savings}%
        </span>
      )}
      <div class="flex items-baseline gap-1.5 mt-2">
        <span class="font-display text-xl opacity-70">{currency}</span>
        <span class="font-display font-medium text-[52px] leading-none tracking-[-0.01em]">{price}</span>
      </div>
      <p class="text-xs font-light tracking-[0.14em] uppercase opacity-60 mt-2">{paymentType}</p>
    </div>

    <div class={`gold-divider !mx-0 mb-7 ${featured ? "w-full opacity-70" : "w-16 opacity-60"}`} />

    <ul class="space-y-3.5 mb-9">
      {features.map((feature) => (
        <li class="flex items-start gap-2.5 text-[14px] font-light leading-relaxed">
          <svg class="w-4 h-4 mt-1 shrink-0 text-brass" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span class="opacity-85">{feature}</span>
        </li>
      ))}
    </ul>

    <a href={resolvedCta} class={ctaClass}>{cta}</a>
  </div>
</div>
