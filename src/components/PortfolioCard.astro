---
interface Props {
  title: string;
  couple: string;
  venue: string;
  category: string;
  coverImage: string;
  slug: string;
  class?: string;
}

const base = import.meta.env.BASE_URL;
const {
  title,
  couple,
  venue,
  category,
  coverImage,
  slug,
  class: className = "",
} = Astro.props;

// Remote URLs stay as-is; local public/ paths get the site base (GitHub Pages subpath)
const resolvedCover = coverImage.startsWith("http") ? coverImage : `${base}${coverImage}`;
---

<a
  href={`${base}portfolio/${slug}`}
  class={`group relative block ${className}`}
  data-category={category}
  data-tilt
>
  <div class="bg-canvas-soft-2 dark:bg-[#292524] overflow-hidden rounded-lg shadow-card group-hover:shadow-card-lg transition-all duration-500">
    {/* Full photo at natural aspect — card wraps it tightly, no crop, no filler */}
    <img
      src={resolvedCover}
      alt={`${couple} — ${venue}`}
      class="img-luxe w-full h-auto transition-transform duration-[1.2s] ease-out group-hover:scale-[1.03]"
      loading="lazy"
    />
  </div>

  <!-- Caption — editorial, always visible -->
  <div class="pt-5 pb-1 text-center">
    <p class="text-[11px] uppercase tracking-[0.28em] text-brass-deep dark:text-brass">{category}</p>
    <p class="font-display text-[22px] leading-snug mt-1.5 text-ink dark:text-[#ece7dd]">{couple}</p>
    <p class="text-[13px] font-light tracking-wide text-body dark:text-[#b8b0a3] mt-1">{venue}</p>
  </div>

  <!-- Hover veil -->
  <div class="pointer-events-none absolute inset-0 rounded-lg ring-1 ring-inset ring-brass/0 group-hover:ring-brass/40 transition-all duration-500" />
</a>
