---
interface Props {
  name: string;
  date: string;
  text: string;
  service?: string;
  rating?: number;
  avatar?: string;
  class?: string;
}

const {
  name,
  date,
  text,
  service,
  rating = 5,
  avatar,
  class: className = "",
} = Astro.props;
---

<div class={`relative bg-canvas rounded-lg border border-hairline p-8 pt-10 shadow-card hover:shadow-card-lg hover:-translate-y-1 transition-all duration-300 dark:bg-[#1c1917] dark:border-[#2e2a26] ${className}`}>
  <!-- Oversized serif quote -->
  <span aria-hidden="true" class="font-display absolute top-4 left-7 text-[56px] leading-none text-rose-soft dark:text-[#2e2a26] select-none">&ldquo;</span>

  <!-- Stars -->
  <div class="flex gap-1 mb-4 relative">
    {Array.from({ length: rating }).map((_, i) => (
      <svg class="w-3.5 h-3.5 text-brass" fill="currentColor" viewBox="0 0 20 20" key={i}>
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>

  <!-- Quote -->
  <blockquote class="font-display text-[19px] leading-[1.6] text-ink/90 dark:text-[#ece7dd]/90 mb-6 relative">
    "{text}"
  </blockquote>

  <!-- Attribution -->
  <div class="flex items-center justify-between border-t border-hairline dark:border-[#2e2a26] pt-5">
    <div class="flex items-center gap-3">
      {avatar && (
        <img
          src={avatar}
          alt={name}
          class="w-11 h-11 rounded-full object-cover ring-1 ring-brass/40"
          loading="lazy"
        />
      )}
      <div>
        <p class="text-sm font-medium tracking-wide text-ink dark:text-[#ece7dd]">{name}</p>
        <p class="text-xs font-light tracking-wider text-mute mt-0.5">{date}</p>
      </div>
    </div>
    {service && (
      <span class="text-[11px] uppercase tracking-[0.14em] px-3 py-1.5 rounded-full bg-brass-soft text-brass-deep dark:bg-[#2e2a22] dark:text-brass shrink-0">
        {service}
      </span>
    )}
  </div>
</div>
