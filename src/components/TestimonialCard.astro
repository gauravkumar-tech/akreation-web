---
interface Props {
  name: string;
  date: string;
  text: string;
  service?: string;
  rating?: number;
  avatar?: string;
  class?: string;
}

const {
  name,
  date,
  text,
  service,
  rating = 5,
  avatar,
  class: className = "",
} = Astro.props;
---

<div class={`bg-canvas rounded-lg border border-hairline p-6 shadow-card dark:bg-[#111111] dark:border-[#333333] ${className}`}>
  <!-- Stars -->
  <div class="flex gap-0.5 mb-3">
    {Array.from({ length: rating }).map((_, i) => (
      <svg class="w-4 h-4 text-warning" fill="currentColor" viewBox="0 0 20 20" key={i}>
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>

  <!-- Quote -->
  <blockquote class="text-sm text-body dark:text-[#a1a1a1] leading-relaxed mb-4">
    "{text}"
  </blockquote>

  <!-- Attribution -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      {avatar && (
        <img
          src={avatar}
          alt={name}
          class="w-10 h-10 rounded-full object-cover"
          loading="lazy"
        />
      )}
      <div>
        <p class="text-sm font-medium text-ink dark:text-[#ededed]">{name}</p>
        <p class="text-xs text-mute dark:text-[#666666]">{date}</p>
      </div>
    </div>
    {service && (
      <span class="text-xs px-2.5 py-1 rounded-full bg-canvas-soft-2 text-body dark:bg-[#1a1a1a] dark:text-[#a1a1a1] shrink-0">
        {service}
      </span>
    )}
  </div>
</div>
