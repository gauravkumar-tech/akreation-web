---
import Container from "./ui/Container.astro";

const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();

const services = [
  { href: `${base}services#wedding-photography`, label: "Wedding Photography" },
  { href: `${base}services#wedding-videography`, label: "Wedding Videography" },
  { href: `${base}services#pre-wedding`, label: "Pre-Wedding Sessions" },
  { href: `${base}services#engagement`, label: "Engagement Photos" },
  { href: `${base}services#events`, label: "Events" },
];

const company = [
  { href: `${base}about`, label: "About" },
  { href: `${base}blog`, label: "Blog" },
  { href: `${base}pricing`, label: "Pricing" },
  { href: `${base}contact`, label: "Contact" },
  { href: `${base}locations`, label: "Service Areas" },
];

const legal = [
  { href: `${base}privacy`, label: "Privacy Policy" },
  { href: `${base}terms`, label: "Terms of Service" },
];
---

<footer class="bg-canvas border-t border-hairline dark:bg-[#111111] dark:border-[#333333]">
  <Container class="py-16 lg:py-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      <!-- Brand column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={base} class="font-semibold text-lg tracking-tight text-ink dark:text-[#ededed]">
          A K Studio
        </a>
        <p class="mt-3 text-sm text-body dark:text-[#a1a1a1] max-w-xs">
          Delhi NCR's wedding photography & videography studio. Capturing love stories with candid, documentary, and fine art styles.
        </p>
        <div class="flex items-center gap-3 mt-5">
          <a href="https://instagram.com/ak.studio" target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-full border border-hairline hover:bg-canvas-soft-2 dark:border-[#333333] dark:hover:bg-[#1a1a1a] transition-colors" aria-label="Instagram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://youtube.com/@akstudio" target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-full border border-hairline hover:bg-canvas-soft-2 dark:border-[#333333] dark:hover:bg-[#1a1a1a] transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://wa.me/919999999999" target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-full border border-hairline hover:bg-canvas-soft-2 dark:border-[#333333] dark:hover:bg-[#1a1a1a] transition-colors" aria-label="WhatsApp">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">Services</h3>
        <ul class="space-y-2.5">
          {services.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-body dark:text-[#a1a1a1] hover:text-ink dark:hover:text-[#ededed] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">Company</h3>
        <ul class="space-y-2.5">
          {company.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-body dark:text-[#a1a1a1] hover:text-ink dark:hover:text-[#ededed] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">Get in touch</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="tel:+919999999999" class="text-sm text-body dark:text-[#a1a1a1] hover:text-ink dark:hover:text-[#ededed] transition-colors">
              +91 99999 99999
            </a>
          </li>
          <li>
            <a href="mailto:hello@akreation.in" class="text-sm text-body dark:text-[#a1a1a1] hover:text-ink dark:hover:text-[#ededed] transition-colors">
              hello@akreation.in
            </a>
          </li>
          <li class="text-sm text-body dark:text-[#a1a1a1]">
            New Delhi, India
          </li>
        </ul>
        <ul class="mt-4 space-y-1.5">
          {legal.map((link) => (
            <li>
              <a href={link.href} class="text-xs text-mute dark:text-[#666666] hover:text-body dark:hover:text-[#a1a1a1] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-hairline dark:border-[#333333] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-mute dark:text-[#666666]">
        &copy; {currentYear} A K Studio. All rights reserved.
      </p>
      <p class="text-xs text-mute dark:text-[#666666]">
        Crafted with love in Delhi
      </p>
    </div>
  </Container>
</footer>
