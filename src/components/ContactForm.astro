---
import Input from "./ui/Input.astro";
import Select from "./ui/Select.astro";
import Button from "./ui/Button.astro";
---

<form
  name="contact"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="space-y-5"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>Don't fill this out: <input name="bot-field" /></label>
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <Input label="Your name" name="name" placeholder="Priya Sharma" required />
    <Input label="Email address" name="email" type="email" placeholder="priya@example.com" required />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <Input label="Phone number" name="phone" type="tel" placeholder="+91 99999 99999" />
    <Input label="Wedding date" name="date" type="date" />
  </div>

  <Select
    label="Service interested in"
    name="service"
    options={[
      { value: "", label: "Select a service..." },
      { value: "wedding-photography", label: "Wedding Photography" },
      { value: "wedding-videography", label: "Wedding Videography" },
      { value: "both", label: "Photography + Videography" },
      { value: "pre-wedding", label: "Pre-Wedding Session" },
      { value: "engagement", label: "Engagement Photos" },
      { value: "events", label: "Other Events" },
    ]}
  />

  <div>
    <label for="message" class="block text-sm font-medium text-ink dark:text-[#ededed] mb-1.5">
      Tell us about your wedding
    </label>
    <textarea
      name="message"
      id="message"
      rows={4}
      placeholder="Tell us about your celebration — venue, guest count, what matters most to you..."
      class="w-full px-3 py-2.5 text-sm bg-canvas text-ink border border-hairline rounded-md placeholder:text-mute focus:outline-none focus:ring-2 focus:ring-link/20 focus:border-link dark:bg-[#111111] dark:text-[#ededed] dark:border-[#333333] dark:placeholder:text-[#666666] dark:focus:ring-[#0070f3]/20 dark:focus:border-[#0070f3] resize-none"
    ></textarea>
  </div>

  <Button type="submit" variant="primary" size="lg" class="w-full sm:w-auto">
    Send inquiry
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </Button>
</form>
