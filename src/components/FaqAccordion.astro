---
interface Props {
  question: string;
  open?: boolean;
  class?: string;
}

const { question, open = false, class: className = "" } = Astro.props;
---

<div
  class={`faq-item border-b border-hairline dark:border-[#2e2a26] ${className}`}
  data-faq
  data-open={open ? "true" : "false"}
>
  <button
    type="button"
    data-faq-button
    aria-expanded={open ? "true" : "false"}
    class="flex w-full items-center justify-between gap-6 py-6 cursor-pointer text-left text-ink dark:text-[#ece7dd] font-display text-[20px] hover:text-brass-deep dark:hover:text-brass transition-colors"
  >
    <span>{question}</span>
    <span class="faq-icon w-9 h-9 shrink-0 flex items-center justify-center rounded-full border border-hairline-strong/40 text-brass-deep transition-all duration-500">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
    </span>
  </button>
  <div class="faq-panel" data-faq-panel>
    <div class="overflow-hidden">
      <div class="faq-body pb-7 pr-14 text-body dark:text-[#b8b0a3] text-[15px] font-light leading-[1.8]">
        <slot />
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll("[data-faq]:not([data-faq-ready])").forEach ((item) => {
    item.setAttribute("data-faq-ready", "1");
    const btn = item.querySelector("[data-faq-button]");
    btn?.addEventListener("click", () => {
      const isOpen = item.getAttribute("data-open") === "true";
      item.setAttribute("data-open", String(!isOpen));
      btn.setAttribute("aria-expanded", String(!isOpen));
    });
  });
</script>
