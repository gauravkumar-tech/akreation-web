---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/ui/Container.astro";
import { getCollection, render } from "astro:content";

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
>
  <Header slot="header" />

  <article class="py-16 md:py-24">
    <Container>
      <!-- Post header -->
      <header class="max-w-3xl mx-auto mb-12 text-center" data-reveal>
        <a href={`${base}blog`} class="inline-flex items-center gap-2 text-[12px] font-medium uppercase tracking-[0.22em] text-body dark:text-[#b8b0a3] hover:text-brass-deep dark:hover:text-brass transition-colors mb-8">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0l7 7m-7-7l7-7" />
          </svg>
          Back to journal
        </a>
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="text-[11px] font-medium uppercase tracking-[0.22em] px-3 py-1.5 rounded-full bg-brass-soft text-brass-deep dark:bg-[#2e2a22] dark:text-brass">{post.data.category}</span>
          <time class="text-xs font-light tracking-wider text-mute">{fmt(post.data.pubDate)}</time>
        </div>
        <h1 class="font-display font-medium text-4xl md:text-[56px] leading-[1.08] tracking-[-0.01em] text-ink dark:text-[#ece7dd]">
          {post.data.title}
        </h1>
        <div class="gold-divider w-24 mx-auto mt-7" />
        {post.data.tags && (
          <div class="flex flex-wrap justify-center gap-2 mt-6">
            {post.data.tags.map((tag) => (
              <span class="px-3 py-1 rounded-full border border-hairline-strong/30 text-xs font-light tracking-wide text-mute">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Post content -->
      <div
        class="max-w-3xl mx-auto prose prose-lg dark:prose-invert font-light
          prose-headings:font-display prose-headings:font-medium prose-headings:tracking-[-0.01em]
          prose-p:text-body dark:prose-p:text-[#cfc8ba] prose-p:leading-[1.9]
          prose-a:text-brass-deep dark:prose-a:text-brass prose-a:no-underline hover:prose-a:text-rose-deep dark:hover:prose-a:text-rose hover:prose-a:underline hover:prose-a:underline-offset-4
          prose-strong:text-ink dark:prose-strong:text-[#ece7dd] prose-strong:font-medium
          prose-blockquote:border-champagne dark:prose-blockquote:border-brass/50 prose-blockquote:font-display prose-blockquote:italic prose-blockquote:text-xl
          prose-img:rounded-lg prose-img:shadow-card-lg
          prose-hr:border-hairline dark:prose-hr:border-[#2e2a26]"
        data-reveal
      >
        <Content />
      </div>

      <!-- Author bio -->
      <div class="max-w-3xl mx-auto mt-16" data-reveal>
        <div class="flex items-center gap-5 bg-canvas dark:bg-[#1c1917] border border-hairline dark:border-[#2e2a26] rounded-lg p-7 shadow-card">
          <div class="w-14 h-14 shrink-0 rounded-full border border-brass/50 flex items-center justify-center font-display text-lg text-brass" aria-hidden="true">
            AK
          </div>
          <div>
            <p class="font-display font-medium text-xl text-ink dark:text-[#ece7dd]">{post.data.author}</p>
            <p class="text-[13px] font-light tracking-wide text-mute mt-1">A K Studio — Delhi NCR Wedding Photography</p>
          </div>
        </div>
      </div>

      <!-- Related posts -->
      {related.length > 0 && (
        <div class="max-w-3xl mx-auto mt-14" data-reveal>
          <div class="flex items-center gap-4 mb-7">
            <h2 class="font-display italic text-2xl text-ink dark:text-[#ece7dd] whitespace-nowrap">Keep reading</h2>
            <div class="gold-divider flex-1 opacity-60" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {related.map((p) => (
              <a href={`${base}blog/${p.id}`} class="group block bg-canvas dark:bg-[#1c1917] border border-hairline dark:border-[#2e2a26] rounded-lg p-6 shadow-card hover:shadow-card-lg hover:-translate-y-1 hover:border-brass/50 transition-all duration-500">
                <p class="text-[11px] font-medium uppercase tracking-[0.22em] text-brass-deep dark:text-brass mb-2.5">{p.data.category}</p>
                <p class="font-display font-medium text-[21px] leading-snug text-ink dark:text-[#ece7dd] group-hover:text-brass-deep dark:group-hover:text-brass transition-colors">
                  {p.data.title}
                </p>
                <p class="text-[13px] font-light text-mute mt-2 line-clamp-2">{p.data.description.slice(0, 80)}...</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </Container>
  </article>

  <Footer slot="footer" />
</BaseLayout>
