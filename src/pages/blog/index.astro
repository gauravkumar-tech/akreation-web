---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/ui/Container.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);
---

<BaseLayout
  title="Blog"
  description="Stories and tips from A K Studio. Wedding inspiration, real wedding stories, pre-wedding tips, and behind-the-scenes from Delhi NCR."
>
  <Header slot="header" />

  <section class="py-20 md:py-32">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-16">
        <p class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">Blog</p>
        <h1 class="font-semibold text-4xl md:text-[48px] leading-[1.1] tracking-[-0.04em] text-ink dark:text-[#ededed]">
          Stories & tips.
        </h1>
        <p class="mt-6 text-lg leading-7 text-body dark:text-[#a1a1a1]">
          Real weddings, helpful guides, and behind-the-scenes stories from our studio.
        </p>
      </div>

      <!-- Featured post -->
      {featured && (
        <article class="mb-16">
          <a href={`/blog/${featured.id}`} class="group grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center bg-canvas dark:bg-[#111111] rounded-xl border border-hairline dark:border-[#333333] p-6 lg:p-8 shadow-card hover:shadow-card-lg transition-shadow">
            <div class="aspect-[16/10] bg-canvas-soft-2 dark:bg-[#1a1a1a] rounded-lg overflow-hidden">
              <div class="w-full h-full bg-gradient-to-br from-canvas-soft-2 to-hairline dark:from-[#1a1a1a] dark:to-[#333333] flex items-center justify-center text-mute dark:text-[#666666]">
                <svg class="w-12 h-12 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
              </div>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-mono uppercase tracking-wider text-link dark:text-[#0070f3]">{featured.data.category}</span>
                <span class="text-xs text-mute dark:text-[#666666]">&middot;</span>
                <time class="text-xs text-mute dark:text-[#666666]">{featured.data.pubDate.toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })}</time>
              </div>
              <h2 class="font-semibold text-2xl text-ink dark:text-[#ededed] group-hover:text-body dark:group-hover:text-[#a1a1a1] transition-colors leading-snug mb-3">
                {featured.data.title}
              </h2>
              <p class="text-sm text-body dark:text-[#a1a1a1] line-clamp-2 mb-4">
                {featured.data.description}
              </p>
              <p class="text-sm font-medium text-link dark:text-[#0070f3]">
                Read more &rarr;
              </p>
            </div>
          </a>
        </article>
      )}

      <!-- Post grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {rest.map((post) => (
          <article>
            <a href={`/blog/${post.id}`} class="group block bg-canvas dark:bg-[#111111] rounded-lg border border-hairline dark:border-[#333333] overflow-hidden shadow-card hover:shadow-card-lg transition-shadow">
              <div class="aspect-[16/10] bg-canvas-soft-2 dark:bg-[#1a1a1a] overflow-hidden">
                <div class="w-full h-full bg-gradient-to-br from-canvas-soft-2 to-hairline dark:from-[#1a1a1a] dark:to-[#333333] flex items-center justify-center text-mute dark:text-[#666666]">
                  <svg class="w-10 h-10 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
              </div>
              <div class="p-5">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xs font-mono uppercase tracking-wider text-link dark:text-[#0070f3]">{post.data.category}</span>
                  <span class="text-xs text-mute dark:text-[#666666]">&middot;</span>
                  <time class="text-xs text-mute dark:text-[#666666]">{post.data.pubDate.toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })}</time>
                </div>
                <h2 class="font-semibold text-base text-ink dark:text-[#ededed] group-hover:text-body dark:group-hover:text-[#a1a1a1] transition-colors leading-snug">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm text-body dark:text-[#a1a1a1] line-clamp-2">
                  {post.data.description}
                </p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
