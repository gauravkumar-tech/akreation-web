---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/ui/Container.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const posts = await getCollection("blog", ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout
  title="Blog"
  description="Stories and tips from A K Studio. Wedding inspiration, real wedding stories, pre-wedding tips, and behind-the-scenes from Delhi NCR."
>
  <Header slot="header" />

  <section class="py-20 md:py-32">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-16" data-reveal>
        <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-5">Blog</p>
        <h1 class="font-display font-medium text-5xl md:text-[64px] leading-[1.05] tracking-[-0.01em] text-ink dark:text-[#ece7dd]">
          Stories <span class="italic text-rosegold">& tips.</span>
        </h1>
        <div class="gold-divider w-24 mx-auto mt-7" />
        <p class="mt-6 text-[17px] font-light leading-[1.8] text-body dark:text-[#b8b0a3]">
          Real weddings, helpful guides, and behind-the-scenes stories from our studio.
        </p>
      </div>

      <!-- Featured post -->
      {featured && (
        <article class="mb-14" data-reveal>
          <a href={`${base}blog/${featured.id}`} class="group grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center bg-canvas dark:bg-[#1c1917] rounded-lg border border-hairline dark:border-[#2e2a26] p-6 lg:p-10 shadow-card hover:shadow-card-lg hover:-translate-y-1 transition-all duration-500">
            <div class="aspect-[16/10] rounded-md overflow-hidden ring-1 ring-hairline dark:ring-[#2e2a26]">
              <div class="img-luxe w-full h-full bg-gradient-to-br from-brass-soft via-canvas-soft-2 to-champagne dark:from-[#2e2a22] dark:via-[#292524] dark:to-[#1c1917] flex items-center justify-center transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]">
                <span class="font-display italic text-4xl text-brass-deep/40 dark:text-brass/40 select-none">
                  {featured.data.category}
                </span>
              </div>
            </div>
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-[11px] font-medium uppercase tracking-[0.22em] px-3 py-1.5 rounded-full bg-brass-soft text-brass-deep dark:bg-[#2e2a22] dark:text-brass">{featured.data.category}</span>
                <time class="text-xs font-light tracking-wider text-mute">{fmt(featured.data.pubDate)}</time>
              </div>
              <h2 class="font-display font-medium text-3xl md:text-[40px] leading-[1.15] text-ink dark:text-[#ece7dd] group-hover:text-brass-deep dark:group-hover:text-brass transition-colors">
                {featured.data.title}
              </h2>
              <p class="mt-4 text-[15px] font-light leading-[1.8] text-body dark:text-[#b8b0a3] line-clamp-2">
                {featured.data.description}
              </p>
              <p class="mt-6 text-[12px] font-medium uppercase tracking-[0.22em] text-brass-deep dark:text-brass inline-flex items-center gap-2">
                Read the story
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </p>
            </div>
          </a>
        </article>
      )}

      <!-- Post grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal-group>
        {rest.map((post) => (
          <article>
            <a href={`${base}blog/${post.id}`} class="group block h-full bg-canvas dark:bg-[#1c1917] rounded-lg border border-hairline dark:border-[#2e2a26] overflow-hidden shadow-card hover:shadow-card-lg hover:-translate-y-1.5 transition-all duration-500">
              <div class="aspect-[16/10] overflow-hidden">
                <div class="img-luxe w-full h-full bg-gradient-to-br from-brass-soft via-canvas-soft-2 to-champagne dark:from-[#2e2a22] dark:via-[#292524] dark:to-[#1c1917] flex items-center justify-center transition-transform duration-[1.2s] ease-out group-hover:scale-[1.06]">
                  <span class="font-display italic text-3xl text-brass-deep/40 dark:text-brass/40 select-none">
                    {post.data.category}
                  </span>
                </div>
              </div>
              <div class="p-7">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-[11px] font-medium uppercase tracking-[0.22em] text-brass-deep dark:text-brass">{post.data.category}</span>
                  <span class="w-1 h-1 rotate-45 bg-brass/70 shrink-0" aria-hidden="true" />
                  <time class="text-xs font-light tracking-wider text-mute">{fmt(post.data.pubDate)}</time>
                </div>
                <h2 class="font-display font-medium text-[26px] leading-[1.25] text-ink dark:text-[#ece7dd] group-hover:text-brass-deep dark:group-hover:text-brass transition-colors">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-[14px] font-light leading-[1.75] text-body dark:text-[#b8b0a3] line-clamp-2">
                  {post.data.description}
                </p>
                <p class="mt-5 text-[11px] font-medium uppercase tracking-[0.22em] text-brass-deep/80 dark:text-brass/80 inline-flex items-center gap-2">
                  Read the story
                  <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
