---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import locations from "../data/locations.json";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Service Areas"
  description="A K Studio serves couples across Delhi NCR — New Delhi, Gurugram, Noida, Faridabad, Ghaziabad, and Greater Noida. No travel fees within NCR."
>
  <Header slot="header" />

  <section class="py-20 md:py-32">
    <Container>
      <SectionHeader
        eyebrow="Service areas"
        title="Serving couples across Delhi NCR"
        description="No travel fees within Delhi NCR. We cover all major cities and venues across the National Capital Region."
      />

      <!-- City cards -->
      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {locations.map((loc) => (
          <a
            href={`${base}locations/${loc.slug}`}
            class="group block bg-canvas dark:bg-[#111111] rounded-lg border border-hairline dark:border-[#333333] p-6 shadow-card hover:shadow-card-lg transition-shadow"
          >
            <div class="flex items-center gap-3 mb-3">
              <svg class="w-5 h-5 text-link dark:text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
              <h2 class="font-semibold text-base text-ink dark:text-[#ededed] group-hover:text-body dark:group-hover:text-[#a1a1a1] transition-colors">
                {loc.city}
              </h2>
            </div>
            <p class="text-sm text-body dark:text-[#a1a1a1] leading-relaxed">{loc.description}</p>
            <p class="mt-3 text-sm text-link dark:text-[#0070f3] font-medium group-hover:underline">
              View venues in {loc.city} &rarr;
            </p>
          </a>
        ))}
      </div>

      <!-- Map section -->
      <div class="mt-16 aspect-[2/1] bg-canvas-soft-2 dark:bg-[#1a1a1a] rounded-xl overflow-hidden border border-hairline dark:border-[#333333]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d224345.83961582096!2d77.06889764063199!3d28.527582024297606!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390cfd5b347eb62d%3A0x52c2b7494e204dce!2sNew%20Delhi%2C%20Delhi!5e0!3m2!1sen!2sin!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Delhi NCR service area map"
        ></iframe>
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="py-20 md:py-32 bg-canvas-soft dark:bg-[#0a0a0a]">
    <Container>
      <div class="max-w-2xl mx-auto">
        <h2 class="font-semibold text-3xl md:text-[32px] leading-10 tracking-[-0.026em] text-center text-ink dark:text-[#ededed]">
          Travel & coverage questions.
        </h2>
        <div class="mt-12 space-y-6">
          <div class="bg-canvas dark:bg-[#111111] rounded-lg border border-hairline dark:border-[#333333] p-6">
            <h3 class="font-medium text-base text-ink dark:text-[#ededed] mb-2">Do you travel outside NCR?</h3>
            <p class="text-sm text-body dark:text-[#a1a1a1] leading-relaxed">Absolutely! We regularly travel across India — Jaipur, Udaipur, Goa, Kerala, and beyond. Please contact us for a custom travel quote.</p>
          </div>
          <div class="bg-canvas dark:bg-[#111111] rounded-lg border border-hairline dark:border-[#333333] p-6">
            <h3 class="font-medium text-base text-ink dark:text-[#ededed] mb-2">What are your travel fees?</h3>
            <p class="text-sm text-body dark:text-[#a1a1a1] leading-relaxed">Within Delhi NCR, there are no travel fees. For outstation weddings, we charge actual travel costs (fuel, tolls, or flights) plus accommodation if required.</p>
          </div>
          <div class="bg-canvas dark:bg-[#111111] rounded-lg border border-hairline dark:border-[#333333] p-6">
            <h3 class="font-medium text-base text-ink dark:text-[#ededed] mb-2">Can we meet before booking?</h3>
            <p class="text-sm text-body dark:text-[#a1a1a1] leading-relaxed">Of course! We'd love to meet you in person at our studio or over a video call to discuss your wedding plans and show you our full portfolio.</p>
          </div>
        </div>

        <div class="mt-10 text-center">
          <Button variant="primary" size="md" href={`${base}contact`}>
            Inquire about your location
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
