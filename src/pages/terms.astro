---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
---

<BaseLayout
  title="Terms of Service"
  description="Terms of Service for A K Studio. Please read these terms carefully before booking our services."
>
  <Header slot="header" />

  <section class="py-16 md:py-24">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-12" data-reveal>
        <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-5">Legal</p>
        <h1 class="font-display font-medium text-5xl md:text-[60px] leading-[1.05] tracking-[-0.01em] text-ink dark:text-[#ece7dd]">
          Terms of <span class="italic text-rosegold">Service.</span>
        </h1>
        <div class="gold-divider w-24 mx-auto mt-7" />
        <p class="mt-5 text-sm font-light tracking-wide text-mute">Last updated: January 2025</p>
      </div>
      <article
        class="max-w-3xl mx-auto bg-canvas dark:bg-[#1c1917] border border-hairline dark:border-[#2e2a26] rounded-lg p-8 md:p-12 shadow-card prose dark:prose-invert font-light
          prose-headings:font-display prose-headings:font-medium prose-headings:tracking-[-0.01em]
          prose-h2:text-[28px] prose-h2:mt-10
          prose-p:text-body dark:prose-p:text-[#cfc8ba] prose-p:leading-[1.9] prose-p:text-[15px]
          prose-li:text-body dark:prose-li:text-[#cfc8ba] prose-li:font-light prose-li:text-[15px] prose-li:marker:text-brass
          prose-a:text-brass-deep dark:prose-a:text-brass hover:prose-a:text-rose-deep
          prose-strong:text-ink dark:prose-strong:text-[#ece7dd] prose-strong:font-medium"
        data-reveal
      >

        <h2>Booking & Payment</h2>
        <p>
          A 25% booking fee is required to secure your date. The remaining balance is due 14 days before the event. All prices are in INR and include applicable taxes.
        </p>

        <h2>Cancellation Policy</h2>
        <p>
          If you need to cancel, please notify us as early as possible. The booking fee is non-refundable but may be transferred to a new date subject to availability.
        </p>

        <h2>Delivery Timeline</h2>
        <p>
          Edited photos are delivered within 4–6 weeks of the wedding. Wedding films are delivered within 8–12 weeks. A sneak peek of 20–30 photos is shared within 48 hours.
        </p>

        <h2>Client Conduct</h2>
        <p>
          We strive to provide the best possible service. However, we reserve the right to terminate coverage if we experience unsafe conditions or unreasonable behavior that affects our ability to deliver.
        </p>

        <h2>Limitation of Liability</h2>
        <p>
          While we take every precaution, in the unlikely event of equipment failure or technical issues, our liability is limited to a full refund of fees paid. We recommend couples consider wedding insurance for additional coverage.
        </p>

        <h2>Contact</h2>
        <p>
          For questions about these terms, please email us at <a href="mailto:hello@akreation.in">hello@akreation.in</a>.
        </p>
      </article>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
