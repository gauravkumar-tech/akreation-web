---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import PricingCard from "../components/PricingCard.astro";
import pricing from "../data/pricing.json";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Pricing"
  description="Transparent pricing for wedding photography and videography in Delhi NCR. Essential ₹35K, Premium ₹65K, Luxe ₹1.25L. Every package includes professional editing and online gallery."
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-20 md:py-32">
    <Container>
      <div class="max-w-3xl mx-auto text-center" data-reveal>
        <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-5">Pricing</p>
        <h1 class="font-display font-medium text-5xl md:text-[64px] leading-[1.05] tracking-[-0.01em] text-ink dark:text-[#ece7dd]">
          Transparent <span class="italic text-rosegold">pricing.</span>
        </h1>
        <div class="gold-divider w-24 mx-auto mt-7" />
        <p class="mt-6 text-[17px] font-light leading-[1.8] text-body dark:text-[#b8b0a3] max-w-2xl mx-auto">
          No hidden fees, no surprise charges. Choose the package that fits your celebration. All prices are in INR and include GST.
        </p>
      </div>

      <!-- Pricing Cards -->
      <div class="mt-16 grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        {pricing.map((tier, i) => (
          <PricingCard
            {...tier}
            class={tier.featured ? "lg:-mt-4 lg:mb-4" : ""}
          />
        ))}
      </div>
    </Container>
  </section>

  <!-- Comparison FAQ -->
  <section class="py-20 md:py-32 bg-canvas-soft dark:bg-[#141210]">
    <Container>
      <div class="max-w-2xl mx-auto" data-reveal>
        <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-5">Good to know</p>
        <h2 class="font-display font-medium text-4xl md:text-5xl leading-[1.08] text-center text-ink dark:text-[#ece7dd]">
          Questions about pricing.
        </h2>
        <div class="gold-divider w-24 mx-auto mt-7" />

        <div class="mt-12 space-y-5">
          <div class="bg-canvas dark:bg-[#1c1917] rounded-lg border border-hairline dark:border-[#2e2a26] p-7 shadow-card">
            <h3 class="font-display font-medium text-[22px] text-ink dark:text-[#ece7dd] mb-2">What's included in the price?</h3>
            <p class="text-[14px] font-light text-body dark:text-[#b8b0a3] leading-[1.8]">
              Every package includes professional editing, color grading, an online gallery to share with family, and full print release so you can order prints anywhere.
            </p>
          </div>
          <div class="bg-canvas dark:bg-[#1c1917] rounded-lg border border-hairline dark:border-[#2e2a26] p-7 shadow-card">
            <h3 class="font-display font-medium text-[22px] text-ink dark:text-[#ece7dd] mb-2">Do you offer payment plans?</h3>
            <p class="text-[14px] font-light text-body dark:text-[#b8b0a3] leading-[1.8]">
              Yes! We offer flexible payment plans. A 25% booking fee secures your date, with the remaining balance split into 2–3 installments leading up to the wedding.
            </p>
          </div>
          <div class="bg-canvas dark:bg-[#1c1917] rounded-lg border border-hairline dark:border-[#2e2a26] p-7 shadow-card">
            <h3 class="font-display font-medium text-[22px] text-ink dark:text-[#ece7dd] mb-2">Can we customize a package?</h3>
            <p class="text-[14px] font-light text-body dark:text-[#b8b0a3] leading-[1.8]">
              Absolutely. Every wedding is unique. We're happy to add extra hours, a second shooter, or specific deliverables. Contact us for a custom quote.
            </p>
          </div>
          <div class="bg-canvas dark:bg-[#1c1917] rounded-lg border border-hairline dark:border-[#2e2a26] p-7 shadow-card">
            <h3 class="font-display font-medium text-[22px] text-ink dark:text-[#ece7dd] mb-2">How do travel fees work?</h3>
            <p class="text-[14px] font-light text-body dark:text-[#b8b0a3] leading-[1.8]">
              There are no travel fees within Delhi NCR. For weddings outside NCR, we charge actual travel costs plus accommodation. We've photographed weddings across India and love traveling for couples.
            </p>
          </div>
        </div>

        <div class="mt-10 text-center">
          <Button variant="primary" size="md" href={`${base}contact`}>
            Have questions? Let's talk
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
