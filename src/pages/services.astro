---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Services"
  description="Wedding photography, videography, pre-wedding sessions, and event coverage across Delhi NCR. A K Studio captures your most meaningful moments."
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-20 md:py-32">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <p class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">Our services</p>
        <h1 class="font-semibold text-4xl md:text-[48px] leading-[1.1] tracking-[-0.04em] text-ink dark:text-[#ededed]">
          Photography and film for every celebration.
        </h1>
        <p class="mt-6 text-lg leading-7 text-body dark:text-[#a1a1a1]">
          From intimate engagement sessions to grand multi-day weddings, we offer a complete range of services to document your love story.
        </p>
      </div>
    </Container>
  </section>

  <!-- Wedding Photography -->
  <section id="wedding-photography" class="py-20 md:py-32 bg-canvas-soft dark:bg-[#0a0a0a] scroll-mt-16">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-card-lg">
          <img
            src="https://placehold.co/800x600/171717/fafafa?text=Wedding+Photography&font=inter"
            alt="Wedding photography service"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">01</p>
          <h2 class="font-semibold text-3xl md:text-[32px] leading-10 tracking-[-0.026em] text-ink dark:text-[#ededed]">
            Wedding Photography.
          </h2>
          <p class="mt-4 text-lg leading-7 text-body dark:text-[#a1a1a1]">
            Your wedding day is a whirlwind of emotions, rituals, and celebrations. We're there to capture every moment — from the quiet morning preparations to the last dance of the night.
          </p>
          <ul class="mt-6 space-y-2">
            {["Candid & documentary coverage", "Traditional family portraits", "Fine art couple sessions", "Detail shots of decor, jewelry & venue", "Same-day sneak peek (20–30 photos)", "Professional editing & color grading"].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-body dark:text-[#a1a1a1]">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-link dark:text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- Wedding Videography -->
  <section id="wedding-videography" class="py-20 md:py-32 scroll-mt-16">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="order-2 lg:order-1">
          <p class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">02</p>
          <h2 class="font-semibold text-3xl md:text-[32px] leading-10 tracking-[-0.026em] text-ink dark:text-[#ededed]">
            Wedding Videography.
          </h2>
          <p class="mt-4 text-lg leading-7 text-body dark:text-[#a1a1a1]">
            A wedding film captures what photos can't — the sound of your vows, the music of the ceremony, the laughter and tears in motion.
          </p>
          <ul class="mt-6 space-y-2">
            {["Highlight film (3–5 minutes)", "Cinematic wedding film (8–12 minutes)", "Drone aerial footage", "Same-day edits (Luxe package)", "Multi-camera ceremony coverage", "Licensed music & professional audio"].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-body dark:text-[#a1a1a1]">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-link dark:text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="order-1 lg:order-2 aspect-[4/3] rounded-xl overflow-hidden shadow-card-lg">
          <img
            src="https://placehold.co/800x600/171717/fafafa?text=Wedding+Videography&font=inter"
            alt="Wedding videography service"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Pre-Wedding -->
  <section id="pre-wedding" class="py-20 md:py-32 bg-canvas-soft dark:bg-[#0a0a0a] scroll-mt-16">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-card-lg">
          <img
            src="https://placehold.co/800x600/171717/fafafa?text=Pre-Wedding+Session&font=inter"
            alt="Pre-wedding and engagement session"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">03</p>
          <h2 class="font-semibold text-3xl md:text-[32px] leading-10 tracking-[-0.026em] text-ink dark:text-[#ededed]">
            Pre-Wedding & Engagement.
          </h2>
          <p class="mt-4 text-lg leading-7 text-body dark:text-[#a1a1a1]">
            Capture the excitement of this special time with a couple session at an iconic Delhi location. Perfect for save-the-dates, wedding invites, and social media.
          </p>
          <ul class="mt-6 space-y-2">
            {["1–2 hour photo session", "Multiple outfit changes", "Iconic Delhi locations", "Professional editing", "Online gallery", "Starting from ₹15,000"].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-body dark:text-[#a1a1a1]">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-link dark:text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- Events -->
  <section id="events" class="py-20 md:py-32 scroll-mt-16">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="order-2 lg:order-1">
          <p class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">04</p>
          <h2 class="font-semibold text-3xl md:text-[32px] leading-10 tracking-[-0.026em] text-ink dark:text-[#ededed]">
            Events & Celebrations.
          </h2>
          <p class="mt-4 text-lg leading-7 text-body dark:text-[#a1a1a1]">
            Beyond weddings, we capture the joy of all your special occasions — birthday parties, anniversaries, corporate events, and more.
          </p>
          <ul class="mt-6 space-y-2">
            {["Birthday parties & milestone celebrations", "Anniversary events", "Corporate events & conferences", "Baby showers & naming ceremonies", "Festival celebrations"].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-body dark:text-[#a1a1a1]">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-link dark:text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="order-1 lg:order-2 aspect-[4/3] rounded-xl overflow-hidden shadow-card-lg">
          <img
            src="https://placehold.co/800x600/171717/fafafa?text=Events+%26+Celebrations&font=inter"
            alt="Events and celebrations photography"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-32 bg-primary text-on-primary dark:bg-[#ededed] dark:text-[#171717]">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="font-semibold text-3xl md:text-[32px] leading-10 tracking-[-0.026em]">
          Ready to book?
        </h2>
        <p class="mt-4 text-lg opacity-70">
          Let's discuss your celebration and find the perfect package for your needs.
        </p>
        <div class="mt-8">
          <Button variant="secondary" size="lg" href={`${base}contact`}>
            Get in touch
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
