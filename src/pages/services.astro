---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

const base = import.meta.env.BASE_URL;

const checkCls = "w-4 h-4 mt-0.5 shrink-0 text-brass";
const checkPath = "M5 13l4 4L19 7";
---

<BaseLayout
  title="Services"
  description="Wedding photography, videography, pre-wedding sessions, and event coverage across Delhi NCR. A K Studio captures your most meaningful moments."
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-20 md:py-32">
    <Container>
      <div class="max-w-3xl mx-auto text-center" data-reveal>
        <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-5">Our services</p>
        <h1 class="font-display font-medium text-5xl md:text-[64px] leading-[1.05] tracking-[-0.01em] text-ink dark:text-[#ece7dd]">
          Photography and film for every <span class="italic text-rosegold">celebration.</span>
        </h1>
        <div class="gold-divider w-24 mx-auto mt-7" />
        <p class="mt-6 text-[17px] font-light leading-[1.8] text-body dark:text-[#b8b0a3]">
          From intimate engagement sessions to grand multi-day weddings, we offer a complete range of services to document your love story.
        </p>
      </div>
    </Container>
  </section>

  <!-- Wedding Photography -->
  <section id="wedding-photography" class="py-20 md:py-32 bg-canvas-soft dark:bg-[#141210] scroll-mt-20">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center" data-reveal>
        <div class="group aspect-[4/3] rounded-lg overflow-hidden shadow-card-lg ring-1 ring-hairline dark:ring-[#2e2a26]">
          <img
            src="https://placehold.co/800x600/171717/fafafa?text=Wedding+Photography&font=inter"
            alt="Wedding photography service"
            class="img-luxe w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
            loading="lazy"
          />
        </div>
        <div>
          <p class="font-display italic text-[15px] tracking-[0.2em] text-rose-deep/80 dark:text-rose mb-3">N° 01</p>
          <h2 class="font-display font-medium text-4xl md:text-5xl leading-[1.08] text-ink dark:text-[#ece7dd]">
            Wedding Photography.
          </h2>
          <div class="gold-divider w-24 mt-6 !mx-0" />
          <p class="mt-6 text-[17px] font-light leading-[1.8] text-body dark:text-[#b8b0a3]">
            Your wedding day is a whirlwind of emotions, rituals, and celebrations. We're there to capture every moment — from the quiet morning preparations to the last dance of the night.
          </p>
          <ul class="mt-6 space-y-2.5">
            {["Candid & documentary coverage", "Traditional family portraits", "Fine art couple sessions", "Detail shots of decor, jewelry & venue", "Same-day sneak peek (20–30 photos)", "Professional editing & color grading"].map((item) => (
              <li class="flex items-start gap-2.5 text-[15px] font-light text-body dark:text-[#b8b0a3]">
                <svg class={checkCls} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={checkPath} />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- Wedding Videography -->
  <section id="wedding-videography" class="py-20 md:py-32 scroll-mt-20">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center" data-reveal>
        <div class="order-2 lg:order-1">
          <p class="font-display italic text-[15px] tracking-[0.2em] text-rose-deep/80 dark:text-rose mb-3">N° 02</p>
          <h2 class="font-display font-medium text-4xl md:text-5xl leading-[1.08] text-ink dark:text-[#ece7dd]">
            Wedding Videography.
          </h2>
          <div class="gold-divider w-24 mt-6 !mx-0" />
          <p class="mt-6 text-[17px] font-light leading-[1.8] text-body dark:text-[#b8b0a3]">
            A wedding film captures what photos can't — the sound of your vows, the music of the ceremony, the laughter and tears in motion.
          </p>
          <ul class="mt-6 space-y-2.5">
            {["Highlight film (3–5 minutes)", "Cinematic wedding film (8–12 minutes)", "Drone aerial footage", "Same-day edits (Luxe package)", "Multi-camera ceremony coverage", "Licensed music & professional audio"].map((item) => (
              <li class="flex items-start gap-2.5 text-[15px] font-light text-body dark:text-[#b8b0a3]">
                <svg class={checkCls} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={checkPath} />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="order-1 lg:order-2 group aspect-[4/3] rounded-lg overflow-hidden shadow-card-lg ring-1 ring-hairline dark:ring-[#2e2a26]">
          <img
            src="https://placehold.co/800x600/171717/fafafa?text=Wedding+Videography&font=inter"
            alt="Wedding videography service"
            class="img-luxe w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
            loading="lazy"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Pre-Wedding -->
  <section id="pre-wedding" class="py-20 md:py-32 bg-canvas-soft dark:bg-[#141210] scroll-mt-20">
    <span id="engagement" class="block scroll-mt-24" aria-hidden="true"></span>
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center" data-reveal>
        <div class="group aspect-[4/3] rounded-lg overflow-hidden shadow-card-lg ring-1 ring-hairline dark:ring-[#2e2a26]">
          <img
            src="https://placehold.co/800x600/171717/fafafa?text=Pre-Wedding+Session&font=inter"
            alt="Pre-wedding and engagement session"
            class="img-luxe w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
            loading="lazy"
          />
        </div>
        <div>
          <p class="font-display italic text-[15px] tracking-[0.2em] text-rose-deep/80 dark:text-rose mb-3">N° 03</p>
          <h2 class="font-display font-medium text-4xl md:text-5xl leading-[1.08] text-ink dark:text-[#ece7dd]">
            Pre-Wedding & Engagement.
          </h2>
          <div class="gold-divider w-24 mt-6 !mx-0" />
          <p class="mt-6 text-[17px] font-light leading-[1.8] text-body dark:text-[#b8b0a3]">
            Capture the excitement of this special time with a couple session at an iconic Delhi location. Perfect for save-the-dates, wedding invites, and social media.
          </p>
          <ul class="mt-6 space-y-2.5">
            {["1–2 hour photo session", "Multiple outfit changes", "Iconic Delhi locations", "Professional editing", "Online gallery", "Starting from ₹15,000"].map((item) => (
              <li class="flex items-start gap-2.5 text-[15px] font-light text-body dark:text-[#b8b0a3]">
                <svg class={checkCls} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={checkPath} />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- Events -->
  <section id="events" class="py-20 md:py-32 scroll-mt-20">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center" data-reveal>
        <div class="order-2 lg:order-1">
          <p class="font-display italic text-[15px] tracking-[0.2em] text-rose-deep/80 dark:text-rose mb-3">N° 04</p>
          <h2 class="font-display font-medium text-4xl md:text-5xl leading-[1.08] text-ink dark:text-[#ece7dd]">
            Events & Celebrations.
          </h2>
          <div class="gold-divider w-24 mt-6 !mx-0" />
          <p class="mt-6 text-[17px] font-light leading-[1.8] text-body dark:text-[#b8b0a3]">
            Beyond weddings, we capture the joy of all your special occasions — birthday parties, anniversaries, corporate events, and more.
          </p>
          <ul class="mt-6 space-y-2.5">
            {["Birthday parties & milestone celebrations", "Anniversary events", "Corporate events & conferences", "Baby showers & naming ceremonies", "Festival celebrations"].map((item) => (
              <li class="flex items-start gap-2.5 text-[15px] font-light text-body dark:text-[#b8b0a3]">
                <svg class={checkCls} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={checkPath} />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="order-1 lg:order-2 group aspect-[4/3] rounded-lg overflow-hidden shadow-card-lg ring-1 ring-hairline dark:ring-[#2e2a26]">
          <img
            src="https://placehold.co/800x600/171717/fafafa?text=Events+%26+Celebrations&font=inter"
            alt="Events and celebrations photography"
            class="img-luxe w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
            loading="lazy"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="grain relative py-24 md:py-32 bg-espresso text-[#fdfbf7] overflow-hidden dark:bg-[#0e0c0a]">
    <div aria-hidden="true" class="blush-glow absolute inset-0 pointer-events-none" />
    <Container class="relative z-10">
      <div class="max-w-2xl mx-auto text-center" data-reveal>
        <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-6">
          Get in touch
        </p>
        <h2 class="font-display font-medium text-4xl md:text-6xl leading-[1.06]">
          Ready to <span class="italic text-rosegold">book?</span>
        </h2>
        <div class="gold-divider w-28 mx-auto mt-7 opacity-80" />
        <p class="mt-7 text-[17px] font-light leading-[1.8] text-[#cfc8ba]">
          Let's discuss your celebration and find the perfect package for your needs.
        </p>
        <div class="mt-10">
          <Button variant="primary" size="lg" href={`${base}contact`} class="!bg-[#fdfbf7] !text-espresso hover:!bg-rose-deep hover:!text-white hover:!shadow-rose">
            Get in touch
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
