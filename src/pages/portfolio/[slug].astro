---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import portfolio from "../../data/portfolio.json";

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  return portfolio.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;

// Remote URLs stay as-is; local public/ paths get the site base (GitHub Pages subpath)
const resolveImg = (s: string) => (s.startsWith("http") ? s : `${base}${s}`);
---

<BaseLayout
  title={item.title}
  description={item.description}
>
  <Header slot="header" />

  <section class="py-16 md:py-24">
    <Container>
      <div class="max-w-4xl mx-auto">
        <!-- Back link -->
        <a href={`${base}portfolio`} class="inline-flex items-center gap-2 text-[12px] font-medium uppercase tracking-[0.22em] text-body dark:text-[#b8b0a3] hover:text-brass-deep dark:hover:text-brass transition-colors mb-10" data-reveal>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0l7 7m-7-7l7-7" />
          </svg>
          Back to portfolio
        </a>

        <!-- Header -->
        <div class="text-center" data-reveal>
          <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-5">
            {item.category} · {item.style}
          </p>
          <h1 class="font-display font-medium text-5xl md:text-[64px] leading-[1.05] tracking-[-0.01em] text-ink dark:text-[#ece7dd]">
            {item.couple}
          </h1>
          <div class="gold-divider w-24 mx-auto mt-7" />
          <p class="mt-5 font-display italic text-[22px] text-body dark:text-[#b8b0a3]">{item.venue}</p>
          <p class="mt-2 text-xs font-light tracking-[0.18em] uppercase text-mute">{new Date(item.date).toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })}</p>
        </div>

        <!-- Description -->
        <p class="mt-10 text-[17px] font-light text-body dark:text-[#b8b0a3] leading-[1.85] max-w-2xl mx-auto text-center" data-reveal>
          {item.description}
        </p>

        <!-- Gallery — centered hero portrait flanked by catalog rails -->
        {item.images.length > 0 ? (
          <>
            <p class="mt-14 text-center text-[11px] uppercase tracking-[0.28em] text-brass-deep dark:text-brass" data-reveal>
              The celebration in frames
            </p>
            <div class="mt-6 grid grid-cols-1 lg:grid-cols-[1fr_1.25fr_1fr] gap-4 md:gap-5 items-center" data-reveal-group>
              {/* Left catalog rail */}
              <div class="order-2 lg:order-1 grid grid-cols-3 lg:grid-cols-1 gap-3 md:gap-4">
                {["object-[50%_0%]", "object-[50%_22%]", "object-[50%_44%]"].map((pos) => (
                  <div class="group aspect-square rounded-md overflow-hidden bg-canvas-soft-2 dark:bg-[#292524] ring-1 ring-hairline dark:ring-[#2e2a26] shadow-card hover:shadow-card-lg hover:-translate-y-1 transition-all duration-500">
                    <img
                      src={resolveImg(item.images[0])}
                      alt={`${item.couple} detail`}
                      class={`img-luxe w-full h-full object-cover ${pos} transition-transform duration-[1.2s] ease-out group-hover:scale-110`}
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>

              {/* Main portrait, centered */}
              <div class="order-1 lg:order-2" data-reveal>
                <div class="group rounded-lg overflow-hidden bg-canvas-soft-2 dark:bg-[#292524] ring-1 ring-hairline dark:ring-[#2e2a26] shadow-card-lg">
                  <img
                    src={resolveImg(item.images[0])}
                    alt={`${item.couple} — ${item.venue}`}
                    class="img-luxe w-full h-auto transition-transform duration-[1.2s] ease-out group-hover:scale-[1.02]"
                    fetchpriority="high"
                  />
                </div>
                <p class="mt-4 text-center font-display italic text-lg text-body dark:text-[#b8b0a3]">
                  {item.couple} — {item.venue}
                </p>
              </div>

              {/* Right catalog rail */}
              <div class="order-3 grid grid-cols-3 lg:grid-cols-1 gap-3 md:gap-4">
                {["object-[50%_56%]", "object-[50%_78%]", "object-[50%_100%]"].map((pos) => (
                  <div class="group aspect-square rounded-md overflow-hidden bg-canvas-soft-2 dark:bg-[#292524] ring-1 ring-hairline dark:ring-[#2e2a26] shadow-card hover:shadow-card-lg hover:-translate-y-1 transition-all duration-500">
                    <img
                      src={resolveImg(item.images[0])}
                      alt={`${item.couple} detail`}
                      class={`img-luxe w-full h-full object-cover ${pos} transition-transform duration-[1.2s] ease-out group-hover:scale-110`}
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            </div>

            {/* Any additional gallery photos */}
            {item.images.length > 1 && (
              <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-5 items-start">
                {item.images.slice(1).map((img) => (
                  <div class="group rounded-lg overflow-hidden bg-canvas-soft-2 dark:bg-[#292524] ring-1 ring-hairline dark:ring-[#2e2a26] shadow-card hover:shadow-card-lg transition-all duration-500">
                    <img
                      src={resolveImg(img)}
                      alt={`${item.couple} photo`}
                      class="img-luxe w-full h-auto transition-transform duration-[1.2s] ease-out group-hover:scale-[1.02]"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="aspect-[4/3] rounded-lg overflow-hidden">
              <img
                src={`https://placehold.co/800x600/171717/fafafa?text=${encodeURIComponent(item.couple)}&font=inter`}
                alt={`${item.couple} photo`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="aspect-[4/3] rounded-lg overflow-hidden">
              <img
                src={`https://placehold.co/800x600/1a1a2e/eef0f5?text=${encodeURIComponent(item.venue)}&font=inter`}
                alt={`${item.couple} at ${item.venue}`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        )}

        <!-- CTA -->
        <div class="grain relative mt-16 p-10 md:p-12 bg-espresso text-[#fdfbf7] rounded-lg text-center overflow-hidden dark:bg-[#0e0c0a]" data-reveal>
          <div aria-hidden="true" class="blush-glow absolute inset-0 pointer-events-none" />
          <div class="relative z-10">
            <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-4">Your turn</p>
            <p class="font-display font-medium text-3xl md:text-4xl">Love this style?</p>
            <p class="mt-3 text-[15px] font-light text-[#cfc8ba]">Let's create something similar for your wedding.</p>
            <div class="mt-7">
              <Button variant="primary" size="md" href={`${base}contact`} class="!bg-[#fdfbf7] !text-espresso hover:!bg-rose-deep hover:!text-white hover:!shadow-rose">
                Book your wedding
              </Button>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
