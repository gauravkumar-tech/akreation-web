---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy Policy for A K Studio. Learn how we collect, use, and protect your personal information."
>
  <Header slot="header" />

  <section class="py-16 md:py-24">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-12" data-reveal>
        <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-5">Legal</p>
        <h1 class="font-display font-medium text-5xl md:text-[60px] leading-[1.05] tracking-[-0.01em] text-ink dark:text-[#ece7dd]">
          Privacy <span class="italic text-rosegold">Policy.</span>
        </h1>
        <div class="gold-divider w-24 mx-auto mt-7" />
        <p class="mt-5 text-sm font-light tracking-wide text-mute">Last updated: January 2025</p>
      </div>
      <article
        class="max-w-3xl mx-auto bg-canvas dark:bg-[#1c1917] border border-hairline dark:border-[#2e2a26] rounded-lg p-8 md:p-12 shadow-card prose dark:prose-invert font-light
          prose-headings:font-display prose-headings:font-medium prose-headings:tracking-[-0.01em]
          prose-h2:text-[28px] prose-h2:mt-10
          prose-p:text-body dark:prose-p:text-[#cfc8ba] prose-p:leading-[1.9] prose-p:text-[15px]
          prose-li:text-body dark:prose-li:text-[#cfc8ba] prose-li:font-light prose-li:text-[15px] prose-li:marker:text-brass
          prose-a:text-brass-deep dark:prose-a:text-brass hover:prose-a:text-rose-deep
          prose-strong:text-ink dark:prose-strong:text-[#ece7dd] prose-strong:font-medium"
        data-reveal
      >

        <h2>Information We Collect</h2>
        <p>
          When you fill out our contact form or book our services, we collect:
        </p>
        <ul>
          <li>Your name and contact information (email, phone number)</li>
          <li>Wedding date and venue details</li>
          <li>Service preferences and requirements</li>
          <li>Any other information you choose to share with us</li>
        </ul>

        <h2>How We Use Your Information</h2>
        <p>We use your information to:</p>
        <ul>
          <li>Respond to your inquiries and provide quotes</li>
          <li>Deliver our photography and videography services</li>
          <li>Send you relevant information about your booking</li>
          <li>Share your wedding photos with your permission</li>
        </ul>

        <h2>Data Protection</h2>
        <p>
          We take data protection seriously. Your personal information is stored securely and never shared with third parties without your explicit consent, except where required by law.
        </p>

        <h2>Photography Rights</h2>
        <p>
          We retain copyright of all photographs and videos we create. We may use images from your wedding for portfolio and marketing purposes unless you explicitly opt out.
        </p>

        <h2>Contact</h2>
        <p>
          For any questions about this policy, please email us at <a href="mailto:akdigitalstudio732@gmail.com">akdigitalstudio732@gmail.com</a>.
        </p>
      </article>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
