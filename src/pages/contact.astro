---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with A K Studio. Book your wedding date, ask about packages, or schedule a consultation. Delhi NCR wedding photography."
>
  <Header slot="header" />

  <section class="py-20 md:py-32">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-16">
        <p class="font-mono text-xs uppercase tracking-widest text-mute dark:text-[#666666] mb-4">Contact</p>
        <h1 class="font-semibold text-4xl md:text-[48px] leading-[1.1] tracking-[-0.04em] text-ink dark:text-[#ededed]">
          Let's connect.
        </h1>
        <p class="mt-6 text-lg leading-7 text-body dark:text-[#a1a1a1]">
          Tell us about your celebration. We'll get back to you within 24 hours with a personalized quote.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Form -->
        <div>
          <ContactForm />
        </div>

        <!-- Info -->
        <div class="space-y-8">
          <!-- Contact info -->
          <div class="p-6 bg-canvas dark:bg-[#111111] rounded-lg border border-hairline dark:border-[#333333]">
            <h2 class="font-medium text-base text-ink dark:text-[#ededed] mb-4">Contact information</h2>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-mute dark:text-[#666666] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 3.75v4.5m0-4.5h-4.5m4.5 0l-6 6m3 12c-8.284 0-15-6.716-15-15V4.5A2.25 2.25 0 014.5 2.25h1.372c.516 0 .966.351 1.09.852l1.292 5.206a1.125 1.125 0 01-.525 1.235l-1.628.905a12.002 12.002 0 007.44 7.44l.905-1.628a1.125 1.125 0 011.235-.525l5.206 1.292c.501.124.852.574.852 1.09V19.5a2.25 2.25 0 01-2.25 2.25h-2.25z" />
                </svg>
                <div>
                  <p class="text-sm text-ink dark:text-[#ededed] font-medium">Phone</p>
                  <a href="tel:+919999999999" class="text-sm text-body dark:text-[#a1a1a1] hover:text-ink dark:hover:text-[#ededed] transition-colors">+91 99999 99999</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-mute dark:text-[#666666] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <div>
                  <p class="text-sm text-ink dark:text-[#ededed] font-medium">Email</p>
                  <a href="mailto:hello@akreation.in" class="text-sm text-body dark:text-[#a1a1a1] hover:text-ink dark:hover:text-[#ededed] transition-colors">hello@akreation.in</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-mute dark:text-[#666666] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <div>
                  <p class="text-sm text-ink dark:text-[#ededed] font-medium">Studio</p>
                  <p class="text-sm text-body dark:text-[#a1a1a1]">New Delhi, India</p>
                  <p class="text-sm text-body dark:text-[#a1a1a1]">Serving all of Delhi NCR</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Business hours -->
          <div class="p-6 bg-canvas dark:bg-[#111111] rounded-lg border border-hairline dark:border-[#333333]">
            <h2 class="font-medium text-base text-ink dark:text-[#ededed] mb-4">Business hours</h2>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-body dark:text-[#a1a1a1]">Monday – Sunday</span>
                <span class="text-ink dark:text-[#ededed] font-medium">10:00 – 14:00</span>
              </div>
              <div class="flex justify-between">
                <span class="text-body dark:text-[#a1a1a1]">Monday – Sunday</span>
                <span class="text-ink dark:text-[#ededed] font-medium">17:00 – 21:30</span>
              </div>
            </div>
          </div>

          <!-- Map -->
          <div class="aspect-[16/9] bg-canvas-soft-2 dark:bg-[#1a1a1a] rounded-lg overflow-hidden border border-hairline dark:border-[#333333]">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d224345.83961582096!2d77.06889764063199!3d28.527582024297606!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390cfd5b347eb62d%3A0x52c2b7494e204dce!2sNew%20Delhi%2C%20Delhi!5e0!3m2!1sen!2sin!4v1"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="A K Studio service area — New Delhi"
            ></iframe>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
