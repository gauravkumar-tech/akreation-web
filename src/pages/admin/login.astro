---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/ui/Container.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Admin Login"
  description="A K Studio atelier admin sign in."
>
  <Header slot="header" />

  <section class="py-20 md:py-28">
    <Container>
      <div class="max-w-md mx-auto" data-reveal>
        <div class="text-center mb-8">
          <div class="w-14 h-14 mx-auto rounded-full border border-brass/50 flex items-center justify-center font-display text-[22px] tracking-[0.08em] text-brass mb-6" aria-hidden="true">
            AK
          </div>
          <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-4">Atelier Admin</p>
          <h1 class="font-display font-medium text-4xl md:text-5xl text-ink dark:text-[#ece7dd]">
            Welcome <span class="italic text-rosegold">back.</span>
          </h1>
          <div class="gold-divider w-24 mx-auto mt-6" />
        </div>

        <form
          id="admin-login-form"
          class="bg-canvas dark:bg-[#1c1917] border border-hairline dark:border-[#2e2a26] rounded-lg p-8 shadow-card"
          autocomplete="off"
        >
          <label for="passcode" class="block text-[11px] font-medium uppercase tracking-[0.24em] text-mute mb-3">
            Studio passcode
          </label>
          <input
            type="password"
            id="passcode"
            name="passcode"
            placeholder="••••••••"
            class="w-full h-12 px-4 rounded-md bg-canvas-soft dark:bg-[#141210] border border-hairline-strong/40 focus:border-brass focus:ring-2 focus:ring-brass/20 outline-none transition-all text-ink dark:text-[#ece7dd] tracking-[0.2em]"
          />
          <p id="login-error" class="hidden mt-3 text-sm text-error">Incorrect passcode. Please try again.</p>
          <button
            type="submit"
            class="btn-shine mt-6 w-full h-12 inline-flex items-center justify-center rounded-full bg-espresso text-[#fdfbf7] font-medium text-[13px] uppercase tracking-[0.16em] hover:bg-rose-deep hover:shadow-rose transition-all dark:bg-[#ece7dd] dark:text-[#1c1917] dark:hover:bg-rose dark:hover:text-white"
          >
            Enter dashboard
          </button>
        </form>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />

  <script is:inline define:vars={{ base }}>
    (() => {
      const PASSCODE = "akstudio2026";
      if (sessionStorage.getItem("ak_admin") === "1") {
        window.location.replace(`${base}admin/`);
        return;
      }
      const form = document.getElementById("admin-login-form");
      const input = document.getElementById("passcode");
      const err = document.getElementById("login-error");
      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        if (input.value === PASSCODE) {
          sessionStorage.setItem("ak_admin", "1");
          window.location.href = `${base}admin/`;
        } else {
          err?.classList.remove("hidden");
          form.animate(
            [{ transform: "translateX(0)" }, { transform: "translateX(-8px)" }, { transform: "translateX(8px)" }, { transform: "translateX(0)" }],
            { duration: 300 }
          );
          input.select();
        }
      });
    })();
  </script>
</BaseLayout>
