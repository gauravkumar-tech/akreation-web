---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../sections/home/Hero.astro";
import FeaturedWork from "../sections/home/FeaturedWork.astro";
import ServicesOverview from "../sections/home/ServicesOverview.astro";
import VideoShowreel from "../sections/home/VideoShowreel.astro";
import PreWeddingPromo from "../sections/home/PreWeddingPromo.astro";
import Testimonials from "../sections/home/Testimonials.astro";
import InstagramFeed from "../sections/home/InstagramFeed.astro";
import Faq from "../sections/home/Faq.astro";
import CtaBand from "../sections/home/CtaBand.astro";
---

<BaseLayout
  title="Home"
  description="A K Studio — Delhi NCR's premier wedding photography and videography studio. Candid, documentary, and fine art styles for your most meaningful moments."
>
  <Header slot="header" />
  <Hero />
  <FeaturedWork />
  <ServicesOverview />
  <VideoShowreel />
  <PreWeddingPromo />
  <Testimonials />
  <InstagramFeed />
  <Faq />
  <CtaBand />
  <Footer slot="footer" />
</BaseLayout>
