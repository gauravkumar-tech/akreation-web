---
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import HeroSlider from "../../components/HeroSlider.astro";

const base = import.meta.env.BASE_URL;
const heroImg = `${base}images/IMG-20250420-WA0041.jpg`;

// To add more slides, drop photos into public/images/ and append entries here:
// { src: `${base}images/your-photo.jpg`, alt: "Couple portrait at ..." }
const slides = [
  { src: heroImg, alt: "Wedding couple photographed by A K Studio" },
];
---

<section class="grain relative overflow-hidden bg-espresso text-[#fdfbf7]">
  <!-- Cinematic backdrop — real photo ambience -->
  <div class="absolute inset-0">
    <img
      src={heroImg}
      alt=""
      aria-hidden="true"
      class="img-luxe w-full h-full object-cover opacity-40"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-espresso/80 via-espresso/55 to-espresso"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-espresso/60 via-transparent to-espresso/60"></div>
  </div>

  <div class="relative z-10 pt-24 md:pt-32 lg:pt-40 pb-16 md:pb-20">
    <Container>
      <div class="max-w-4xl mx-auto text-center animate-slide-up relative">
        {/* Blush aura behind the headline */}
        <div aria-hidden="true" class="blush-glow absolute -inset-x-24 -top-24 bottom-0 pointer-events-none" />
        <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-7 relative">
          Delhi NCR Wedding Photography & Videography
        </p>
        <h1 class="font-display font-medium text-[44px] leading-[1.04] md:text-7xl lg:text-[84px] tracking-[-0.01em] relative">
          Timeless stories,<br />
          <span class="italic font-normal text-rosegold">captured as they unfold.</span>
        </h1>
        <div class="gold-divider w-32 mx-auto mt-8 opacity-80 relative" />
        <p class="mt-8 text-[17px] md:text-lg leading-[1.8] font-light text-[#d8d1c2] max-w-2xl mx-auto relative">
          A K Studio blends candid documentary and fine art editorial styles to preserve your most meaningful moments.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10 relative">
          <Button variant="primary" size="lg" href={`${base}portfolio`} class="!bg-[#fdfbf7] !text-espresso hover:!bg-rose-deep hover:!text-white hover:!shadow-rose">View our work</Button>
          <Button variant="secondary" size="lg" href={`${base}contact`} class="!bg-transparent !text-[#fdfbf7] !border-white/30 hover:!border-rose hover:!text-rose">Book a consultation</Button>
        </div>
      </div>
    </Container>

    <!-- Hero slider -->
    <Container>
      <div class="mt-14 md:mt-20 max-w-5xl mx-auto">
        <div class="frame-offset rounded-xl">
          <HeroSlider slides={slides} interval={6000} />
        </div>
      </div>
    </Container>

    <!-- Stats strip -->
    <Container>
      <div class="mt-14 grid grid-cols-3 max-w-2xl mx-auto divide-x divide-white/15">
        <div class="text-center px-4">
          <p class="font-display text-3xl md:text-[40px] leading-none">500+</p>
          <p class="text-[11px] uppercase tracking-[0.24em] text-[#a39c90] mt-2.5">Weddings captured</p>
        </div>
        <div class="text-center px-4">
          <p class="font-display text-3xl md:text-[40px] leading-none">Since '85</p>
          <p class="text-[11px] uppercase tracking-[0.24em] text-[#a39c90] mt-2.5">Years in operation</p>
        </div>
        <div class="text-center px-4">
          <p class="font-display text-3xl md:text-[40px] leading-none">4.9<span class="text-brass text-2xl align-top ml-1">★</span></p>
          <p class="text-[11px] uppercase tracking-[0.24em] text-[#a39c90] mt-2.5">Google rating</p>
        </div>
      </div>

      <!-- Scroll cue -->
      <div class="mt-12 flex flex-col items-center gap-3" aria-hidden="true">
        <span class="text-[10px] uppercase tracking-[0.4em] text-white/40">Scroll</span>
        <span class="scroll-line block w-px h-12 bg-gradient-to-b from-[#f6e27a] to-transparent shadow-[0_0_10px_rgb(246_226_122/0.8)]" />
      </div>
    </Container>
  </div>

  <!-- Soft transition into ivory -->
  <div class="relative h-16 bg-gradient-to-b from-transparent to-canvas-soft dark:to-[#141210]"></div>
</section>
