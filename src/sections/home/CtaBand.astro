---
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

const base = import.meta.env.BASE_URL;
---

<section class="relative py-24 md:py-36 bg-espresso text-[#fdfbf7] overflow-hidden dark:bg-[#0e0c0a]">
  <!-- Backdrop -->
  <div class="absolute inset-0">
    <img
      src="https://placehold.co/1680x720/2a2521/f5eddc?text=Begin+Your+Story&font=inter"
      alt=""
      aria-hidden="true"
      class="img-luxe w-full h-full object-cover opacity-30"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-espresso via-espresso/85 to-espresso"></div>
  </div>
  <span aria-hidden="true" class="font-display italic absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[20vw] leading-none text-white/[0.03] select-none pointer-events-none whitespace-nowrap">Amour</span>

  <Container class="relative">
    <div class="max-w-2xl mx-auto text-center">
      <p class="eyebrow eyebrow-line eyebrow-line--both justify-center !text-brass mb-6">
        Begin your story
      </p>
      <h2 class="font-display font-medium text-4xl md:text-6xl leading-[1.06]">
        Ready to tell <span class="italic text-champagne">your story?</span>
      </h2>
      <div class="gold-divider w-28 mx-auto mt-7 opacity-80" />
      <p class="mt-7 text-[17px] font-light leading-[1.8] text-[#cfc8ba]">
        Let's create something beautiful together. Book your date or download our free wedding planning checklist to get started.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10">
        <Button variant="primary" size="lg" href={`${base}contact`} class="!bg-[#fdfbf7] !text-espresso hover:!bg-brass hover:!text-white">
          Book your date
        </Button>
        <Button variant="ghost" size="lg" href={`${base}contact?download=checklist`} class="!text-[#e8ddc9] hover:!text-brass hover:!bg-white/5 border border-white/20 hover:border-brass/60 rounded-full">
          Download planning checklist
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </Button>
      </div>
      <p class="mt-8 text-[11px] uppercase tracking-[0.28em] text-[#8f877c]">
        Now booking 2026 — 2027 weddings
      </p>
    </div>
  </Container>
</section>
