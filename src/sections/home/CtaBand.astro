---
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
---

<section class="py-20 md:py-32 bg-primary text-on-primary dark:bg-[#ededed] dark:text-[#171717]">
  <Container>
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-semibold text-3xl md:text-[32px] leading-10 tracking-[-0.026em]">
        Ready to tell your story?
      </h2>
      <p class="mt-4 text-lg opacity-70">
        Let's create something beautiful together. Book your date or download our free wedding planning checklist to get started.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
        <Button variant="secondary" size="lg" href="/contact">
          Book your date
        </Button>
        <Button variant="ghost" size="lg" href="/contact?download=checklist" class="text-on-primary dark:text-[#171717] hover:text-ink dark:hover:text-[#ededed]">
          Download planning checklist
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </Button>
      </div>
    </div>
  </Container>
</section>
