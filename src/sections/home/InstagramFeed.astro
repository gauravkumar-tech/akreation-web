---
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import Button from "../../components/ui/Button.astro";

const igPosts = [
  { id: 1, src: "https://placehold.co/400x400/171717/fafafa?text=BTS+1&font=inter", alt: "Behind the scenes" },
  { id: 2, src: "https://placehold.co/400x400/1a1a2e/eef0f5?text=Couple+Shoot&font=inter", alt: "Couple photo" },
  { id: 3, src: "https://placehold.co/400x400/16213e/ccd6f0?text=Wedding+Day&font=inter", alt: "Wedding ceremony" },
  { id: 4, src: "https://placehold.co/400x400/171717/fafafa?text=Details&font=inter", alt: "Wedding details" },
  { id: 5, src: "https://placehold.co/400x400/0f3460/dde4f7?text=Reception&font=inter", alt: "Reception" },
  { id: 6, src: "https://placehold.co/400x400/171717/fafafa?text=Studio&font=inter", alt: "Studio life" },
];
---

<section class="py-20 md:py-32">
  <Container>
    <SectionHeader
      eyebrow="Follow along"
      title="From our feed"
      description="Behind the scenes, recent weddings, and moments from our studio life."
    />

    <div class="mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {igPosts.map((post) => (
        <a
          href="https://instagram.com/ak.studio"
          target="_blank"
          rel="noopener noreferrer"
          class="group aspect-square rounded-lg overflow-hidden relative"
        >
          <img
            src={post.src}
            alt={post.alt}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8 text-center">
      <Button variant="secondary" size="md" href="https://instagram.com/ak.studio" target="_blank">
        Follow @ak.studio
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </Button>
    </div>
  </Container>
</section>
