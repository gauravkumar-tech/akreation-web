---
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";

const base = import.meta.env.BASE_URL;

const services = [
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" /></svg>`,
    title: "Wedding Photography",
    description: "Candid, documentary, and fine art styles to capture every emotion and detail of your celebration.",
    href: `${base}services#wedding-photography`,
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h1.5C5.496 19.5 6 18.996 6 18.375m-3.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-1.5A1.125 1.125 0 0118 18.375M20.625 4.5H3.375m17.25 0c.621 0 1.125.504 1.125 1.125M20.625 4.5h-1.5C18.504 4.5 18 5.004 18 5.625m3.75 0v1.5c0 .621-.504 1.125-1.125 1.125M3.375 4.5c-.621 0-1.125.504-1.125 1.125M3.375 4.5h1.5C5.496 4.5 6 5.004 6 5.625m-3.75 0v1.5c0 .621.504 1.125 1.125 1.125m0 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m1.5-3.75C5.496 8.25 6 7.746 6 7.125v-1.5M4.875 8.25C5.496 8.25 6 8.754 6 9.375v1.5m0-5.25v5.25m0-5.25C6 5.004 6.504 4.5 7.125 4.5h9.75c.621 0 1.125.504 1.125 1.125m1.125 2.625h1.5m-1.5 0A1.125 1.125 0 0118 7.125v-1.5m1.125 2.625c-.621 0-1.125.504-1.125 1.125v1.5m2.625-2.625c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M18 5.625v5.25M7.125 12h9.75m-9.75 0A1.125 1.125 0 016 10.875M7.125 12C6.504 12 6 12.504 6 13.125m0-2.25C6 11.496 5.496 12 4.875 12M18 10.875c0 .621-.504 1.125-1.125 1.125M18 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m-12 5.25v-5.25m0 5.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125m-12 0v-1.5c0-.621-.504-1.125-1.125-1.125M18 18.375v-5.25m0 5.25v-1.5c0-.621.504-1.125 1.125-1.125M18 13.125v1.5c0 .621.504 1.125 1.125 1.125M18 13.125c0-.621.504-1.125 1.125-1.125M6 13.125v1.5c0 .621-.504 1.125-1.125 1.125M6 13.125C6 12.504 5.496 12 4.875 12m-1.5 0h1.5m-1.5 0c-.621 0-1.125-.504-1.125-1.125v-1.5c0-.621.504-1.125 1.125-1.125m1.5 3.75c-.621 0-1.125-.504-1.125-1.125" /></svg>`,
    title: "Wedding Videography",
    description: "Cinematic films and highlight reels that bring your wedding story to life with music and motion.",
    href: `${base}services#wedding-videography`,
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>`,
    title: "Pre-Wedding & Engagement",
    description: "Beautiful couple sessions at iconic Delhi locations — perfect for save-the-dates and wedding invites.",
    href: `${base}services#pre-wedding`,
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M18.75 4.236c.982.143 1.954.317 2.916.52A6.003 6.003 0 0016.27 9.728M18.75 4.236V4.5c0 2.108-.966 3.99-2.48 5.228m0 0a6.003 6.003 0 01-2.77.665 6.003 6.003 0 01-2.77-.665m5.54 0a7.454 7.454 0 00-.982 3.172M9.497 14.25c.322 0 .644-.03.963-.086a6.003 6.003 0 01-2.77-.665m0 0a6.003 6.003 0 01-2.77-.665" /></svg>`,
    title: "Events & Celebrations",
    description: "Birthday parties, anniversaries, corporate events — we capture the joy in every gathering.",
    href: `${base}services#events`,
  },
];
---

<section class="grain relative py-24 md:py-32 bg-espresso text-[#ece7dd] overflow-hidden dark:bg-[#0e0c0a]">
  <!-- faint monogram texture -->
  <span aria-hidden="true" class="font-display italic absolute -top-10 left-1/2 -translate-x-1/2 text-[22vw] leading-none text-white/[0.025] select-none pointer-events-none whitespace-nowrap">A K</span>

  <Container class="relative z-10">
    <div class="max-w-3xl mx-auto text-center" data-reveal>
      <p class="font-display italic text-[15px] tracking-[0.2em] text-rose mb-3">
        N° 02
      </p>
      <p class="eyebrow eyebrow-line eyebrow-line--both justify-center mb-5">
        What we do
      </p>
      <h2 class="font-display font-medium text-4xl md:text-5xl leading-[1.08]">
        Photography and film for every occasion.
      </h2>
      <p class="mt-5 text-[17px] leading-[1.75] font-light text-[#b8b0a3] max-w-2xl mx-auto">
        Since 1985, capturing love stories across Delhi NCR. Every celebration deserves to be remembered.
      </p>
      <div class="gold-divider w-24 mx-auto mt-7 opacity-70" />
    </div>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" data-reveal-group>
      {services.map((service, i) => (
        <a
          href={service.href}
          class="group block p-8 rounded-lg bg-white/[0.04] border border-white/10 hover:border-brass/50 hover:bg-white/[0.07] hover:-translate-y-1.5 transition-all duration-500"
        >
          <div class="flex items-center justify-between mb-7">
            <div class="w-12 h-12 flex items-center justify-center rounded-full border border-brass/40 text-brass group-hover:bg-gradient-to-br group-hover:from-[#f6e27a] group-hover:to-brass group-hover:text-white group-hover:border-[#e9c877] group-hover:shadow-gold transition-all duration-500" set:html={service.icon} />
            <span class="font-display italic text-lg text-white/25">0{i + 1}</span>
          </div>
          <h3 class="font-display text-[24px] leading-tight">{service.title}</h3>
          <p class="mt-3 text-[14px] font-light leading-[1.75] text-[#b8b0a3]">{service.description}</p>
          <p class="mt-6 text-[11px] font-medium uppercase tracking-[0.22em] text-brass/90 flex items-center gap-2">
            Learn more
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </p>
        </a>
      ))}
    </div>
  </Container>
</section>
