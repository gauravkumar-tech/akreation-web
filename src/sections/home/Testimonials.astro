---
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import TestimonialCard from "../../components/TestimonialCard.astro";
import testimonials from "../../data/testimonials.json";
---

<section class="relative overflow-hidden py-24 md:py-32 bg-canvas dark:bg-[#1c1917] border-y border-hairline dark:border-[#2e2a26]">
  <div aria-hidden="true" class="blush-glow-soft absolute inset-0 pointer-events-none" />
  <Container class="relative">
    <SectionHeader
      eyebrow="What couples say"
      title="Trusted by hundreds of couples"
      description="Don't just take our word for it. Here's what our couples have to say about working with A K Studio."
      index="04"
    />

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-group>
      {testimonials.slice(0, 6).map((t) => (
        <TestimonialCard
          name={t.name}
          date={t.date}
          text={t.text}
          service={t.service}
          rating={t.rating}
          avatar={t.avatar}
        />
      ))}
    </div>
  </Container>
</section>
