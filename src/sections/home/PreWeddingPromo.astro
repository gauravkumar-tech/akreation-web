---
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

const base = import.meta.env.BASE_URL;
---

<section class="py-24 md:py-32 bg-canvas-soft dark:bg-[#141210] overflow-hidden">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-center" data-reveal>
      <!-- Image -->
      <div class="relative">
        <div class="frame-offset rounded-xl overflow-hidden shadow-card-lg">
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src={`${base}images/IMG-20250420-WA0041.jpg`}
              alt="Pre-wedding engagement session"
              class="img-luxe w-full h-full object-cover hover:scale-[1.04] transition-transform duration-[1.4s] ease-out"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Simple price note -->
        <div class="absolute -bottom-6 -right-2 sm:right-8 bg-canvas dark:bg-[#1c1917] border border-hairline dark:border-[#2e2a26] rounded-full shadow-card-lg px-6 py-3">
          <p class="text-[14px] tracking-wide text-body dark:text-[#b8b0a3]">Starting at <span class="font-display font-medium text-[19px] text-ink dark:text-[#ece7dd]">₹21,000</span></p>
        </div>
      </div>

      <!-- Content -->
      <div class="lg:pl-2">
        <p class="eyebrow mb-5">
          Pre-wedding & engagement
        </p>
        <h2 class="font-display font-medium text-4xl md:text-[52px] leading-[1.08] text-ink dark:text-[#ece7dd]">
          Before the <span class="italic text-rosegold">big day.</span>
        </h2>
        <div class="gold-divider w-24 mt-6 !mx-0" />
        <p class="mt-6 text-[17px] leading-[1.8] font-light text-body dark:text-[#b8b0a3]">
          Your love story didn't start at the altar. Our pre-wedding and engagement sessions capture the excitement, anticipation, and joy of this special time in your lives.
        </p>
        <p class="mt-4 text-[15px] font-light leading-[1.8] text-body dark:text-[#b8b0a3]">
          Choose from iconic Delhi locations — Lodhi Garden, Humayun's Tomb, Connaught Place, or a spot that's meaningful to you. We'll create images perfect for save-the-dates, wedding invites, and social media.
        </p>

        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-[13px] font-light tracking-wide text-body dark:text-[#b8b0a3]">
          <span class="inline-flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-brass" /> Lodhi Garden</span>
          <span class="inline-flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-brass" /> Humayun's Tomb</span>
          <span class="inline-flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-brass" /> Connaught Place</span>
        </div>

        <div class="mt-9 flex flex-col sm:flex-row gap-4">
          <Button variant="primary" size="md" href={`${base}services#pre-wedding`}>
            Book your session
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>
