---
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import Button from "../../components/ui/Button.astro";
import PortfolioCard from "../../components/PortfolioCard.astro";
import portfolioData from "../../data/portfolio.json";

const featured = portfolioData.filter((p) => p.featured).slice(0, 3);
---

<section class="py-20 md:py-32">
  <Container>
    <SectionHeader
      eyebrow="Featured work"
      title="Every wedding has its own rhythm"
      description="From intimate garden ceremonies to grand palace celebrations, we bring the same dedication and artistry to every wedding."
    />

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((item) => (
        <PortfolioCard
          title={item.title}
          couple={item.couple}
          venue={item.venue}
          category={item.category}
          coverImage={item.coverImage}
          slug={item.id}
        />
      ))}
    </div>

    <div class="mt-10 text-center">
      <Button variant="secondary" size="md" href="/portfolio">
        View full portfolio
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </Button>
    </div>
  </Container>
</section>
